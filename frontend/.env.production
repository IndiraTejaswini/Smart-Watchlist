# Production build environment — read by `vite build`.
#
# The mock transport returns a convincing but fabricated Brief. Shipping it to
# a reviewer would be worse than shipping nothing, so the flag is pinned here
# rather than left to default. src/lib/env.js treats any value but the string
# "true" as false; this states the intent explicitly.
VITE_USE_MOCK=false

# Same-origin. The API and the SPA are served by one FastAPI process, so there
# is no base URL to configure and no CORS to get wrong.
VITE_API_BASE=/api
