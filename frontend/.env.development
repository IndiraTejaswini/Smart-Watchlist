# Frontend development environment.
#
# VITE_USE_MOCK routes every API call to src/lib/mock, which returns payloads
# matching ARCHITECTURE.md §16 exactly behind the same fetch interface as the
# real client. Set it to false once the backend endpoints are up; nothing above
# src/lib/api/client.js changes either way.
VITE_USE_MOCK=true
VITE_API_BASE=/api
