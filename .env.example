# Smart Market Watchlist — copy to .env and fill in.
# .env is gitignored. Never commit real credentials.

# ─── Stores ─────────────────────────────────────────────────────────────────
POSTGRES_USER=swl
POSTGRES_PASSWORD=swl
POSTGRES_DB=swl
POSTGRES_PORT=5432
REDIS_PORT=6379
REDIS_MAXMEMORY=512mb

DATABASE_URL=postgresql+psycopg://swl:swl@localhost:5432/swl
REDIS_URL=redis://localhost:6379/0

# ─── Ingest ─────────────────────────────────────────────────────────────────
# Serve every NSE fetch from data/cache and never touch the network. Set this
# for offline development and for the no-network demo path.
FROM_CACHE_ONLY=false

# ─── Live quotes — ARCHITECTURE.md §14.1 ────────────────────────────────────
# QUOTE_SOURCE selects the implementation behind the QuoteSource abstraction.
#   POLLING    NSE quote endpoint on a POLL_INTERVAL_SECONDS cadence. The
#              shipped default and the documented fallback. Needs no
#              credentials and no broker account.
#   BROKER_WS  A broker websocket feed. Requires the three values below.
#
# This build ships with POLLING. See docs/broker-access.md for the decision and
# what switching would involve.
QUOTE_SOURCE=POLLING
BROKER_API_KEY=
BROKER_API_SECRET=
BROKER_ACCESS_TOKEN=

# ─── App ────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
SERVE_SPA=true
